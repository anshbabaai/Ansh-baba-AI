<!DOCTYPE html>
<html>
<head>
  <title>Ansh Baba AI</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f0f0f0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    #chatbox {
      width: 400px;
      height: 500px;
      background: white;
      border: 2px solid #333;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #messages {
      flex: 1;
      padding: 10px;
      overflow-y: auto;
    }
    .message {
      margin: 5px 0;
      padding: 8px;
      border-radius: 5px;
    }
    .user {
      background: #d1e7dd;
      align-self: flex-end;
    }
    .ai {
      background: #f8d7da;
      align-self: flex-start;
    }
    #inputArea {
      display: flex;
      border-top: 1px solid #ccc;
    }
    #userInput {
      flex: 1;
      padding: 10px;
      border: none;
      outline: none;
    }
    #sendBtn {
      padding: 10px;
      background: #333;
      color: white;
      border: none;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <div id="chatbox">
    <div id="messages"></div>
    <div id="inputArea">
      <input type="text" id="userInput" placeholder="Ask Ansh Baba AI...">
      <button id="sendBtn">Send</button>
    </div>
  </div>

  <script>
    const messages = document.getElementById("messages");
    const userInput = document.getElementById("userInput");
    const sendBtn = document.getElementById("sendBtn");

    function addMessage(text, sender) {
      const msg = document.createElement("div");
      msg.classList.add("message", sender);
      msg.textContent = text;
      messages.appendChild(msg);
      messages.scrollTop = messages.scrollHeight;
    }

    function calculateExpression(input) {
      try {
        // Replace words with symbols
        input = input.toLowerCase()
          .replace(/plus/g, "+")
          .replace(/add/g, "+")
          .replace(/minus/g, "-")
          .replace(/subtract/g, "-")
          .replace(/times/g, "*")
          .replace(/multiply/g, "*")
          .replace(/divide/g, "/");

        // Evaluate safely
        let result = Function("return " + input)();
        if (isNaN(result)) return "Sorry beta, I couldn’t understand that.";
        return "Answer is: " + result;
      } catch {
        return "Hmm... I couldn’t calculate that.";
      }
    }

    function aiResponse(input) {
      input = input.toLowerCase();

      // Check if input contains math keywords or numbers
      if (/[0-9]/.test(input) && /plus|add|minus|subtract|times|multiply|divide|\+|\-|\*|\//.test(input)) {
        return calculateExpression(input);
      }

      // Normal chatbot responses
      if (input.includes("hello")) return "Namaste! I am Ansh Baba AI.";
      if (input.includes("how are you")) return "I am always wise and calm, beta.";
      if (input.includes("your name")) return "My name is Ansh Baba AI.";
      if (input.includes("bye")) return "Goodbye! Stay blessed.";
      return "Hmm... interesting. Tell me more!";
    }

    sendBtn.addEventListener("click", () => {
      const text = userInput.value.trim();
      if (text !== "") {
        addMessage(text, "user");
        const response = aiResponse(text);
        setTimeout(() => addMessage(response, "ai"), 500);
        userInput.value = "";
      }
    });

    userInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") sendBtn.click();
    });
  </script>
</body>
</html>
